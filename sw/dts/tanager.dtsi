// Tanager platform device tree: the plan §5.4 memory map (docs/spec/soc.md §4).
// Preprocessed with cpp before dtc. The including .dts defines:
//   TG_NUM_CORES (1|2), TG_NUM_THREADS (1|2)   harts = cores x threads, mhartid = core * threads + tid
//   TG_RUN_THREADS (default TG_NUM_THREADS)     1 with TG_NUM_THREADS 2: an SMT2 build that runs thread 0
//                                               of each core (until M7, DR-147): harts 0 and 2 only
//   TG_MEM_SIZE                                 DRAM bytes at 0x8000_0000 (64-bit expression)
//   TG_FPU (0|1)                                1 when the core implements F and D
//   TG_POWER_NODE                               label of the syscon that takes the power-off/reboot writes
//   TG_POWER_OFFSET                             byte offset of the power register in that syscon
//   TG_PMU (0|1)                                1 adds the riscv,pmu node (the bench image, DR-141)
//   TG_UART1 (0|1)                              1 adds the PS's UART1 through the PS window as the stdout
//                                               path (stage D's D3, DR-163; TG_PS_WINDOW=1 bitstreams)
//   TG_UART1_STDOUT (0|1)                       with TG_UART1, 0 keeps the stdout path on the PL UART (D4's
//                                               RISC-V mode: Debian's plain earlycon follows it; default 1)
//   TG_SD1 (0|1)                                1 adds the PS's SD1 through the PS window (stage D's D4)
//   TG_INITRD (0|1)                             1 names tanager-host's initrd window in /chosen (D4)
//   TG_BOARD_RESET (0|1)                        1 points reboot and poweroff at the board's reset, CRL_APB
//                                               RESET_CTRL through the PS window (D4's RISC-V mode)
// Values written to the power register (same as the sifive,test0 finisher): 0x5555 off, 0x7777 reboot.

#define TG_HARTS (TG_NUM_CORES * TG_NUM_THREADS)
#ifndef TG_RUN_THREADS
#define TG_RUN_THREADS TG_NUM_THREADS
#endif
#define TG_T0ONLY (TG_NUM_THREADS == 2 && TG_RUN_THREADS == 1)
#ifndef TG_UART1
#define TG_UART1 0
#endif
#ifndef TG_SD1
#define TG_SD1 0
#endif
#ifndef TG_INITRD
#define TG_INITRD 0
#endif
#ifndef TG_BOARD_RESET
#define TG_BOARD_RESET 0
#endif
#ifndef TG_UART1_STDOUT
#define TG_UART1_STDOUT 1
#endif

#if TG_FPU
#define TG_ISA_STR "rv64imafdc_zicsr_zifencei_zba_zbb_zbs_zicond_sstc"
#define TG_ISA_EXT "i", "m", "a", "f", "d", "c", "zicsr", "zifencei", "zba", "zbb", "zbs", "zicond", "sstc"
#else
#define TG_ISA_STR "rv64imac_zicsr_zifencei_zba_zbb_zbs_zicond_sstc"
#define TG_ISA_EXT "i", "m", "a", "c", "zicsr", "zifencei", "zba", "zbb", "zbs", "zicond", "sstc"
#endif

#define TG_CPU(n)                                                       \
	cpu##n: cpu@n {                                                 \
		device_type = "cpu";                                    \
		reg = <n>;                                              \
		compatible = "tanager,tanager", "riscv";                \
		riscv,isa = TG_ISA_STR;                                 \
		riscv,isa-base = "rv64i";                               \
		riscv,isa-extensions = TG_ISA_EXT;                      \
		mmu-type = "riscv,sv39";                                \
		status = "okay";                                        \
		cpu##n##_intc: interrupt-controller {                   \
			#interrupt-cells = <1>;                         \
			compatible = "riscv,cpu-intc";                  \
			interrupt-controller;                           \
		};                                                      \
	}

/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "tanager,soc";

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <10000000>;	// ACLINT mtime: tg_map_pkg::TIMEBASE_HZ

		TG_CPU(0);
#if TG_T0ONLY
#if TG_NUM_CORES > 1
		TG_CPU(2);
#endif
#else
#if TG_HARTS > 1
		TG_CPU(1);
#endif
#if TG_HARTS > 2
		TG_CPU(2);
		TG_CPU(3);
#endif
#endif

		cpu-map {
			cluster0 {
#if TG_NUM_THREADS == 1
				core0 { cpu = <&cpu0>; };
#if TG_NUM_CORES > 1
				core1 { cpu = <&cpu1>; };
#endif
#elif TG_T0ONLY
				core0 { thread0 { cpu = <&cpu0>; }; };
#if TG_NUM_CORES > 1
				core1 { thread0 { cpu = <&cpu2>; }; };
#endif
#else
				core0 {
					thread0 { cpu = <&cpu0>; };
					thread1 { cpu = <&cpu1>; };
				};
#if TG_NUM_CORES > 1
				core1 {
					thread0 { cpu = <&cpu2>; };
					thread1 { cpu = <&cpu3>; };
				};
#endif
#endif
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 (TG_MEM_SIZE >> 32) (TG_MEM_SIZE & 0xffffffff)>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		// ACLINT MSWI + MTIMER in the CLINT layout: msip at 0x0, mtimecmp at 0x4000, mtime at 0xbff8.
		// Interrupt pairs per hart: 3 = machine software, 7 = machine timer.
		clint: clint@2000000 {
			compatible = "riscv,clint0";
			reg = <0x0 0x02000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7
#if TG_T0ONLY
#if TG_NUM_CORES > 1
					       &cpu2_intc 3 &cpu2_intc 7
#endif
#else
#if TG_HARTS > 1
					       &cpu1_intc 3 &cpu1_intc 7
#endif
#if TG_HARTS > 2
					       &cpu2_intc 3 &cpu2_intc 7
					       &cpu3_intc 3 &cpu3_intc 7
#endif
#endif
					      >;
		};

		// PLIC: contexts 2h (machine) and 2h+1 (supervisor) for hart h; 11 = machine external,
		// 9 = supervisor external. Sources: 1-4 virtio slots, 10 UART, 11 host mailbox.
		plic: interrupt-controller@c000000 {
			compatible = "riscv,plic0";
			reg = <0x0 0x0c000000 0x0 0x4000000>;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			interrupt-controller;
			riscv,ndev = <31>;
			interrupts-extended = <&cpu0_intc 11 &cpu0_intc 9
#if TG_T0ONLY
					       // an idle thread's contexts stay in the list, unused (-1), so the
					       // hardware's context 2h, 2h+1 for hart h keeps its place
					       &cpu0_intc 0xffffffff &cpu0_intc 0xffffffff
#if TG_NUM_CORES > 1
					       &cpu2_intc 11 &cpu2_intc 9
					       &cpu2_intc 0xffffffff &cpu2_intc 0xffffffff
#endif
#else
#if TG_HARTS > 1
					       &cpu1_intc 11 &cpu1_intc 9
#endif
#if TG_HARTS > 2
					       &cpu2_intc 11 &cpu2_intc 9
					       &cpu3_intc 11 &cpu3_intc 9
#endif
#endif
					      >;
		};

		uart0: serial@10000000 {
			compatible = "ns16550a";
			reg = <0x0 0x10000000 0x0 0x1000>;
			reg-shift = <0>;
			reg-io-width = <1>;
			clock-frequency = <3686400>;	// the UART's baud reference, emulated from clk_core
			current-speed = <115200>;
			interrupt-parent = <&plic>;
			interrupts = <10>;
		};

#if TG_UART1
		// The PS's UART1 through the PS window (docs/spec/soc.md §8.2, stage D's D3, DR-163): the board's
		// USB serial port, once the A53 has released it; PLIC source 20. No clock-frequency, so OpenSBI
		// keeps the baud rate the A53 set; Linux's driver takes the clocks below.
		uart1: serial@ff010000 {
			compatible = "xlnx,zynqmp-uart", "cdns,uart-r1p12";
			reg = <0x0 0xff010000 0x0 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <20>;
			clocks = <&uart1_ref>, <&lpd_lsbus>;
			clock-names = "uart_clk", "pclk";
			current-speed = <115200>;
		};
#endif

#if TG_SD1
		// The PS's SD1 through the PS window (docs/spec/soc.md §8.2, stage D's D4): the board's card, in the
		// A53's mode (SD high-speed, 50 MHz, 3.3 V; D4's probe), PLIC source 21. Its DMA reaches the RISC-V's
		// RAM through HPM1 and the host DMA port (D-c): bus address 0x5_0000_0000 + offset, coherent. The
		// ZynqMP variant without #clock-cells: its quirks (default speed at 19 MHz, auto-CMD12 reads), no
		// PMU firmware calls, and the tap delays the A53 left untouched.
		ps-dma-bus {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			dma-ranges = <0x5 0x0 0x0 0x80000000 (TG_MEM_SIZE >> 32) (TG_MEM_SIZE & 0xffffffff)>;

			sd1: mmc@ff170000 {
				compatible = "xlnx,zynqmp-8.9a", "arasan,sdhci-8.9a";
				reg = <0x0 0xff170000 0x0 0x1000>;
				interrupt-parent = <&plic>;
				interrupts = <21>;
				clocks = <&sd1_ref>, <&lpd_lsbus>;
				clock-names = "clk_xin", "clk_ahb";
				bus-width = <4>;
				max-frequency = <50000000>;
				no-1-8-v;
				disable-wp;
			};
		};
#endif

#if TG_BOARD_RESET
		// The board's reset (D4's RISC-V mode, docs/spec/soc-d4-modes.md): CRL_APB RESET_CTRL through the PS
		// window, which passes that word while the host's BOARD_CTRL[1] is set (riscv.scr sets it). Its
		// SOFT_RESET bit resets the PS and the PL, and the A53's U-Boot chooses the mode again.
		crl_reset: syscon@ff5e0218 {
			compatible = "syscon";
			reg = <0x0 0xff5e0218 0x0 0x4>;
		};
#endif

#if TG_VIRTIO
		// The forwarded virtio window (docs/spec/soc.md §8.1): four virtio-mmio slots whose registers
		// tanager-host serves, PLIC sources 1-4. Only for bitstreams built with it (TG_VIRTIO_WINDOW=1,
		// CAPS[2]): without it the slots answer denied. A slot the host doesn't serve reads 0, no device.
		virtio_mmio@10010000 {
			compatible = "virtio,mmio";
			reg = <0x0 0x10010000 0x0 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <1>;
		};
		virtio_mmio@10011000 {
			compatible = "virtio,mmio";
			reg = <0x0 0x10011000 0x0 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <2>;
		};
		virtio_mmio@10012000 {
			compatible = "virtio,mmio";
			reg = <0x0 0x10012000 0x0 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <3>;
		};
		virtio_mmio@10013000 {
			compatible = "virtio,mmio";
			reg = <0x0 0x10013000 0x0 0x1000>;
			interrupt-parent = <&plic>;
			interrupts = <4>;
		};
#endif
	};

#if TG_BOARD_RESET
	// The KV260 can't power itself off: poweroff resets the board too, and the boot mode record says what comes
	// next (Debian's clean shutdown keeps RISC-V mode; tanager-mode arm first gives Ubuntu)
	poweroff {
		compatible = "syscon-poweroff";
		regmap = <&crl_reset>;
		offset = <0x0>;
		value = <0x10>;
		mask = <0x10>;
	};

	reboot {
		compatible = "syscon-reboot";
		regmap = <&crl_reset>;
		offset = <0x0>;
		value = <0x10>;
		mask = <0x10>;
	};
#else
	poweroff {
		compatible = "syscon-poweroff";
		regmap = <&TG_POWER_NODE>;
		offset = <TG_POWER_OFFSET>;
		value = <0x5555>;
	};

	reboot {
		compatible = "syscon-reboot";
		regmap = <&TG_POWER_NODE>;
		offset = <TG_POWER_OFFSET>;
		value = <0x7777>;
	};
#endif

#if TG_PMU
	// OpenSBI's PMU event map (its riscv,pmu binding; OpenSBI removes the property before Linux sees
	// it). The core has only mcycle and minstret (no mhpmcounters): CPU_CYCLES on counter 0 and
	// INSTRUCTIONS on counter 2. Without the map, SBI v3's event-info probe reports neither, so
	// Linux's PMU driver can never start them and a user-mode rdcycle reads a stopped counter.
	pmu {
		compatible = "riscv,pmu";
		riscv,event-to-mhpmcounters = <0x00001 0x00001 0x00000001>, <0x00002 0x00002 0x00000004>;
	};
#endif

	// The PS clocks of UART1 and SD1, as the A53's clock tree reports them (D0): uart1_ref and lpd_lsbus at
	// 99,999,999 Hz, sdio1_ref at 166,666,665 Hz
#if TG_UART1
	uart1_ref: clock-uart1-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <99999999>;
	};

#endif
#if TG_SD1
	sd1_ref: clock-sdio1-ref {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <166666665>;
	};

#endif
#if TG_UART1 || TG_SD1
	lpd_lsbus: clock-lpd-lsbus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <99999999>;
	};

#endif
	chosen {
		bootargs = TG_BOOTARGS;
#if TG_INITRD
		// tanager-host load --initrd: the file at 0x8800_0000, zero to the end (Linux's unpacker skips zeros)
		linux,initrd-start = <0x0 0x88000000>;
		linux,initrd-end = <0x0 0x8c000000>;
#endif
#if TG_UART1 && TG_UART1_STDOUT
		stdout-path = "/soc/serial@ff010000";
#else
		stdout-path = "/soc/serial@10000000";
#endif
	};
};
