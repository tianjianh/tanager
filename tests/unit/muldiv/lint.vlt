`verilator_config
// Waivers for `make -C tests/unit/muldiv lint`, on top of rtl/lint.vlt. The core packages are
// linted with the whole core by `make lint`; most of their constants and helpers are not
// used by tg_mul and tg_div alone.
lint_off -rule UNUSEDPARAM  -file "*rtl/core/tg_core_pkg.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/core/tg_core_pkg.sv"
lint_off -rule UNUSEDPARAM  -file "*rtl/core/exec/tg_alu_pkg.sv"
