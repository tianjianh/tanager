`verilator_config
// Lint waivers for the test core (simulation only). Keep each one justified.

// MULH* keep only the upper half of the 128-bit product.
lint_off -rule UNUSEDSIGNAL -file "*sim/tcore/tg_tcore.sv" -match "*'prod'*"
// tg_core's board-debug select: the test core has no debug word to pick from.
lint_off -rule UNUSEDSIGNAL -file "*sim/tcore/tg_tcore.sv" -match "*'dbg_sel_i'*"
