# /etc/systemd/system/sd1-irq-watch.service, in the RISC-V's Debian on p3: soc-2's sd1-irq-probe watch (sw/d4mode)
# from the root's mount through shutdown. In the board's boot campaign (10-20) SD1's interrupt was lost during a
# shutdown, after the per-boot watch had stopped. DefaultDependencies=no keeps this unit out of shutdown's ordinary
# stop, so it runs until systemd-shutdown's last SIGTERM. The capture goes to the console (COM5) and
# /run/sd1-irq-probe.log, as the probe writes it.
# It runs from the card: a copy in /run can't run (Debian mounts /run noexec), and busybox needs the card's libc
# anyway. The watch's commands run every 2 s, so their pages stay cached for when SD1's interrupts stop.
[Unit]
Description=SD1 interrupt probe: watch for mmc0 timeouts (through shutdown)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/sd1-irq-probe watch

[Install]
WantedBy=sysinit.target
